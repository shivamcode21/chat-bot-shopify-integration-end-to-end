# EcommAgents development configuration
# Copy to .env and replace placeholders. Never commit the real .env.

ENVIRONMENT=development

# Required at application startup
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommagents

# LLM provider
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

OPENROUTER_API_KEY=
LLM_MODEL=
GOOGLE_API_KEY=

CHATBOT_BACKEND_URL=http://localhost:8000
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=false

REDIS_URL=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_SEARCH_REST_URL=
UPSTASH_SEARCH_REST_TOKEN=

BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET_ID=
BIGQUERY_TABLE_ID=
BIGQUERY_SERVICE_ACCOUNT_KEY_BASE64=

USE_CONTEXT_GRAPH=true
USE_DB_POOL=true
{
  "manifest_version": 3,
  "name": "Underneat Assistant",
  "version": "1.0.0",
  "description": "Locked extension for Underneat web chat",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://underneat.in/*",
    "https://*.underneat.in/*",
    "https://ecommagents.onrender.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://underneat.in/*",
        "https://*.underneat.in/*"
      ],
      "js": ["content.js"],
      "css": ["widget.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["https://underneat.in/*", "https://*.underneat.in/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

# Copy to .env or export before running security smoke tests.
# Reference: fashion_bot/design_docs/WIDGET_SECURITY_HTTP_AND_WS.md

# --- Target ---
# SECURITY_TEST_API_BASE=https://your-api.example.com
# SECURITY_TEST_API_BASE=http://127.0.0.1:8000

# --- HTTP middleware (agent_controller) ---
# CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173
# MAX_REQUEST_BYTES=2097152
# ENABLE_HTTP_RATE_LIMIT=true
# ENABLE_REDIS_RATE_LIMIT=true
# RATE_LIMIT_WINDOW_SEC=60
# RATE_LIMIT_MAX_REQUESTS=200
# For rate-limit smoke: temporarily use RATE_LIMIT_MAX_REQUESTS=5 and run with --probe-rate-limit
# RATE_LIMIT_FAIL_OPEN=true

# --- WebSocket ---
# REQUIRE_WIDGET_API_KEY=false
# REQUIRE_WIDGET_API_KEY=true
# WIDGET_API_KEY_PEPPER=your-pepper
# MAX_WS_MESSAGE_BYTES=2097152

# Per-client Postgres client_configs (not env):
# widget_api_key_sha256 = {"hash":"<sha256 hex>"}
# widget_allowed_origins = ["https://shop.example.com"]

# --- Widget config JSON ---
# WIDGET_API_ORIGIN=https://api.example.com
# WIDGET_CDN_STATIC_ORIGIN=https://cdn.example.com

# --- Demo Chrome extension backend (separate uvicorn process) ---
# DEMO_CHAT_X_API_KEY=secret-demo-key
# SECURITY_TEST_DEMO_BASE=http://127.0.0.1:8001

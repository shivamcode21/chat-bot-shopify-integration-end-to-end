{
  "test_scenarios": [
    {
      "id": "contract-intent_detection_handler-1",
      "description": "Verify that the agent outputs JSON only for a simple user message.",
      "client_name": "casence",
      "initial_state_fixture": "cold_start",
      "target_agent": "intent_detection_handler",
      "context_assertions": {
        "expected_behaviors": [
          "Output must be strictly JSON."
        ]
      },
      "conversation": [
        {
          "role": "customer",
          "message": "Hello"
        },
        {
          "role": "bot",
          "expected_behavior": "Output JSON only"
        }
      ]
    },
    {
      "id": "contract-intent_detection_handler-2",
      "description": "Verify that the agent routes a message to exactly one agent.",
      "client_name": "casence",
      "initial_state_fixture": "cold_start",
      "target_agent": "intent_detection_handler",
      "context_assertions": {
        "expected_behaviors": [
          "Route message to ONE agent."
        ]
      },
      "conversation": [
        {
          "role": "customer",
          "message": "What is the status of my order?"
        },
        {
          "role": "bot",
          "expected_behavior": "Route to a single agent"
        }
      ]
    },
    {
      "id": "contract-intent_detection_handler-3",
      "description": "Verify that a confirmation response routes to the active topic's agent.",
      "client_name": "casence",
      "initial_state_fixture": "product_page_context",
      "target_agent": "intent_detection_handler",
      "context_assertions": {
        "expected_behaviors": [
          "Route to active topic agent on confirmation."
        ]
      },
      "conversation": [
        {
          "role": "customer",
          "message": "I'm interested in the Sunfire Denim."
        },
        {
          "role": "bot",
          "expected_behavior": "Initiate product inquiry"
        },
        {
          "role": "customer",
          "message": "yes"
        },
        {
          "role": "bot",
          "expected_behavior": "Route to product_inquiry agent"
        }
      ]
    },
    {
      "id": "contract-intent_detection_handler-4",
      "description": "Verify that the agent analyzes template and user response together for intent.",
      "client_name": "casence",
      "initial_state_fixture": "cold_start",
      "target_agent": "intent_detection_handler",
      "context_assertions": {
        "expected_behaviors": [
          "Analyze template and user response together."
        ]
      },
      "conversation": [
        {
          "role": "bot",
          "message": "Bot (Template): Would you like to track your recent order? (yes/no)"
        },
        {
          "role": "customer",
          "message": "yes"
        },
        {
          "role": "bot",
          "expected_behavior": "Derive intent from template and response"
        }
      ]
    },
    {
      "id": "contract-intent_detection_handler-5",
      "description": "Verify that a simple confirmation to a confirmation template matches the correct agent.",
      "client_name": "casence",
      "initial_state_fixture": "cold_start",
      "target_agent": "intent_detection_handler",
      "context_assertions": {
        "expected_behaviors": [
          "Match template's ask to correct agent on confirmation."
        ]
      },
      "conversation": [
        {
          "role": "bot",
          "message": "Bot (Template): Your order GV12345 has been shipped. Reply YES to receive tracking updates."
        },
        {
          "role": "customer",
          "message": "ok"
        },
        {
          "role": "bot",
          "expected_behavior": "Route to order_status agent, not default"
        }
      ]
    },
    {
      "id": "contract-intent_detection_handler-6",
      "description": "Verify that status/tracking request with orderID routes to 'order_status'.",
      "client_name": "casence",
      "initial_state_fixture": "identified_user_with_orders",
      "target_agent": "intent_detection_handler",
      "context_assertions": {
        "expected_behaviors": [
          "Route status/tracking/ETA+orderID to 'order_status'."
        ]
      },
      "conversation": [
        {
          "role": "customer",
          "message": "What is the tracking for order GV12345?"
        },
        {
          "role": "bot",
          "expected_behavior": "Route to order_status agent"
        }
      ]
    },
    {

# Load test environment overrides
# Source this before starting the server: set -a && source .env.loadtest && set +a

LOAD_TEST_MODE=true

# Disable LangSmith (expensive, not needed for load tests)
LANGSMITH_API_KEY=

# Skip final_answer LLM call (reduces per-turn LLM calls)
SKIP_FINAL_ANSWER=true
SKIP_FINAL_ANSWER_WEBCHAT=true

# Mock LLM latency simulation (ms)
MOCK_LLM_DELAY_MS=50

# Cache observability
LOG_TIERED_CACHE_READS=true
LOG_TIERED_CACHE_MEMORY_HITS=true

# OpenTelemetry export to local collector (started via docker-compose)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENVIRONMENT=production

# Server
LOAD_TEST_HOST=localhost
LOAD_TEST_PORT=8000
LOAD_TEST_CLIENT_NAME="Concept Groove"

# Load test parameters
LOAD_TEST_USERS=50
LOAD_TEST_SPAWN_RATE=5
LOAD_TEST_DURATION=5m

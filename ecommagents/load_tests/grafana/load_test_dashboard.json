{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Cache Reads by Tier (rate/5m)",
      "description": "Shows cache_reads_total broken down by tier (memory, redis, db, none). DB should be <= 1 per 5 min per config key.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "memory" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "redis" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "db" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "none" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        {
          "expr": "sum by (tier) (rate(cache_reads_total[5m]))",
          "legendFormat": "{{tier}}"
        }
      ]
    },
    {
      "title": "DB Calls per 5 min (by key_prefix)",
      "description": "Number of config reads that hit the database in each 5-minute window. Should be at most 1 per key_prefix per window.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2, "drawStyle": "bars" }
        }
      },
      "targets": [
        {
          "expr": "sum by (key_prefix) (increase(cache_reads_total{tier=\"db\"}[5m]))",
          "legendFormat": "{{key_prefix}}"
        }
      ]
    },
    {
      "title": "Cache Hit Ratio",
      "description": "Percentage of cache reads served from memory (best) vs other tiers.",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 90 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 * sum(rate(cache_reads_total{tier=\"memory\"}[5m])) / sum(rate(cache_reads_total[5m]))",
          "legendFormat": "Memory hit %"
        }
      ]
    },
    {
      "title": "WebSocket Active Connections",
      "description": "Number of currently active WebSocket connections.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "ws_active_connections",
          "legendFormat": "Active"
        }
      ]
    },
    {
      "title": "Message Throughput (msg/sec)",
      "description": "Rate of WebSocket messages processed per second.",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(ws_messages_total[1m]))",
          "legendFormat": "msg/sec"
        }
      ]
    },
    {
      "title": "Message Latency (p50 / p95 / p99)",
      "description": "End-to-end WebSocket message processing latency percentiles.",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(ws_message_latency_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ws_message_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ws_message_latency_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Error Rate",
      "description": "WebSocket errors per second.",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "custom": { "fillOpacity": 30, "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(ws_errors_total[1m]))",
          "legendFormat": "errors/sec"
        }
      ]
    },
    {
      "title": "DB Connection Pool",
      "description": "PostgreSQL connection pool utilization.",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "db_pool_size",
          "legendFormat": "pool_size"
        },
        {
          "expr": "db_pool_available",
          "legendFormat": "available"
        },
        {
          "expr": "db_pool_waiting",
          "legendFormat": "waiting"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["load-test", "fashion-bot", "websocket"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Fashion Bot - WebSocket Load Test",
  "uid": "fashion-bot-ws-loadtest",
  "version": 1
}
